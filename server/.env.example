# Sankalp payment API — server-side secrets (never expose to the client)
# Copy this file to server/.env and fill in your Razorpay key secret.
# Get it from Razorpay Dashboard -> Settings -> API Keys.

# Required: Razorpay Key Secret (server-side signature verification)
RAZORPAY_KEY_SECRET=

# Optional: defaults to VITE_RAZORPAY_KEY_ID from the root .env
RAZORPAY_KEY_ID=

PORT=5000
