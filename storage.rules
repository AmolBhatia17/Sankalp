rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isInstructor() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'instructor';
    }

    // Instructor avatar photos — public read, owner-only write
    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Course assets (thumbnails, lecture videos, resources) — public read, instructor write
    match /courses/{courseId}/{allPaths=**} {
      allow read: if true;
      allow write: if isInstructor();
    }
  }
}
